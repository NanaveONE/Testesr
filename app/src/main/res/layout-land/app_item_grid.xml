<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_click_layout"
    android:layout_width="194dp"
    android:layout_height="326dp"
    android:layout_marginEnd="-10dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/selected_glow"
        android:layout_width="198dp"
        android:layout_height="298dp"
        android:layout_gravity="top|center_horizontal"
        android:translationY="-5dp"
        android:background="@drawable/home_selected_game_glow"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/selected_panel"
        android:layout_width="194dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="false"
        android:translationY="-5dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="13dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/item_card"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/homePanel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/homePanelStroke"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/icon"
                android:scaleType="centerCrop"
                tools:src="@drawable/default_icon" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_title"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="marquee"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:maxLines="1"
            android:textColor="@color/homeTextPrimary"
            android:textSize="15sp"
            android:visibility="invisible"
            tools:text="ASTRAL CHAIN" />

        <TextView
            android:id="@+id/text_version"
            android:layout_width="170dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_author"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/homeTextSecondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Nintendo" />

        <LinearLayout
            android:id="@+id/selected_actions"
            android:layout_width="170dp"
            android:layout_height="38dp"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/play_button"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/home_selected_action_button"
                android:stateListAnimator="@animator/home_selected_action_press"
                android:drawableStart="@drawable/ic_play_home"
                android:drawablePadding="7dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Play"
                android:textColor="@color/homeTextPrimary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/more_button"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/home_selected_more_button"
                android:stateListAnimator="@animator/home_selected_action_press"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="•••"
                android:textColor="@color/homeTextPrimary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
