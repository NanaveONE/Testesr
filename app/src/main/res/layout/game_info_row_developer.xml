<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_game_developer" app:tint="?attr/colorOnSurface" />
    <TextView android:layout_width="96dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/game_info_developer" android:textSize="12sp" />
    <TextView android:id="@+id/info_developer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:gravity="end" android:maxLines="1" android:textSize="12sp" />
</LinearLayout>
