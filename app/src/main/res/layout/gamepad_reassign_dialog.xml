<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gamepad_reassign_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:animateLayoutChanges="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:focusedByDefault="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/gamepad_reassign_title"
        style="?attr/textAppearanceBodyLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:animateLayoutChanges="true"
        android:text="@string/press_any_button"
        android:textAlignment="center" />

    <RelativeLayout
        android:id="@+id/gamepad_reassign_controller"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:animateLayoutChanges="true"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/gamepad_reassign_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:alpha="0.25"
            android:contentDescription="@string/controller"
            android:src="@drawable/ic_controller" />

        <TextView
            android:id="@+id/gamepad_reassign_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/gamepad_reassign_icon"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@id/gamepad_reassign_icon"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/gamepad_reassign_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/gamepad_reassign_name"
            android:layout_alignStart="@id/gamepad_reassign_name"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="@android:color/tertiary_text_light"
            android:textSize="13sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/gamepad_reassign_cancel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@android:string/cancel" />
    </LinearLayout>
</LinearLayout>
